# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Asgardeo — app-native authentication (the login/signup form talks to these)
# ---------------------------------------------------------------------------
ASGARDEO_ORG_NAME=your-org-name
ASGARDEO_ISSUER_URL=https://api.asgardeo.io/t/your-org-name/oauth2/token
# Optional. Only set this if the org base URL cannot be derived from the issuer above.
# ASGARDEO_BASE_URL=https://api.asgardeo.io/t/your-org-name
ASGARDEO_CLIENT_ID=your-app-native-application-client-id
ASGARDEO_CLIENT_SECRET=your-app-native-application-client-secret
# Must be registered as an Authorized redirect URL on the Asgardeo application AND as an
# Authorized redirect URI on the Google OAuth client. Defaults to
# ${NEXTAUTH_URL}/api/auth/app-native/google/callback when left unset.
# ASGARDEO_APP_NATIVE_REDIRECT_URI=http://localhost:3000/api/auth/app-native/google/callback

# ---------------------------------------------------------------------------
# Asgardeo — server-only M2M application, never exposed to the browser.
# Used for SCIM2 user create/delete and for the password recovery API. The same M2M app needs the
# SCIM2 Users API (internal_user_mgt_*) and the Account Recovery API (internal_user_recovery_create).
# ---------------------------------------------------------------------------
ASGARDEO_SCIM_CLIENT_ID=your-m2m-application-client-id
ASGARDEO_SCIM_CLIENT_SECRET=your-m2m-application-client-secret
# Userstore that new sign-ups land in. Leave as DEFAULT unless you added a custom userstore.
ASGARDEO_USERSTORE_DOMAIN=DEFAULT
# Recovery API version. v2 is the one that serves the flow; v1 answers "not enabled".
ASGARDEO_RECOVERY_API_VERSION=v2
# Set to false to keep rejected users in Asgardeo instead of deleting them.
ASGARDEO_DELETE_REJECTED_USERS=true

# ---------------------------------------------------------------------------
# Email domain restriction
# ---------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=iit.ac.lk
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=iit.ac.lk
# Individual addresses allowed regardless of domain (comma separated), for administrators who
# predate the IIT-only rule. Both values must be kept in step.
ALLOWED_EMAIL_EXCEPTIONS=agzaiyenth@gmail.com
NEXT_PUBLIC_ALLOWED_EMAIL_EXCEPTIONS=agzaiyenth@gmail.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://user:password@localhost:3306/sdgp

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ---------------------------------------------------------------------------
# AI (chatbot)
# ---------------------------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key

# ---------------------------------------------------------------------------
# GitHub (workflows)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your-github-token

# ---------------------------------------------------------------------------
# AWS S3 (uploads)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=your-region
AWS_S3_BUCKET_NAME=your-bucket-name
